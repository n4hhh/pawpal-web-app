# Copy this file to `.env` or `.env.local` and fill the values for local development
# WARNING: Do NOT commit your real service role key to source control.

# Frontend (public) keys used by Vite (safe to use anon key locally)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-side (private) key - ONLY used by serverless functions / dev server
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: local dev/admin user id to allow access to /admin
VITE_DEV_ADMIN_ID=your-dev-admin-uuid